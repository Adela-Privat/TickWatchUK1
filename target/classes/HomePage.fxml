<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="TickWatchUK1.TickWatchUK1.HomeController"
            styleClass="page" prefWidth="1280" prefHeight="720">

   <!-- ============ NAVBAR ============ -->
   <top>
      <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="36">
         <padding>
            <Insets top="22" right="80" bottom="22" left="80" />
         </padding>
         <children>
            <StackPane styleClass="logo-box">
               <children>
                  <Label text="❦" styleClass="logo-icon" />
               </children>
            </StackPane>
            <HBox alignment="CENTER_LEFT" spacing="0">
               <children>
                  <Label text="TickWatch " styleClass="brand-dark" />
                  <Label text="UK" styleClass="brand-green" />
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Explore map" styleClass="nav-link" onAction="#onExploreMap" />
            <Button text="Learn &amp; protect" styleClass="nav-link" onAction="#onLearn" />
            <Button text="About the data" styleClass="nav-link" onAction="#onAbout" />

            <HBox alignment="CENTER" spacing="8">
               <children>
                  <Circle radius="5" styleClass="live-dot" />
                  <Label text="LIVE DATA" styleClass="live-label" />
               </children>
            </HBox>

            <Button text="◎  Report a sighting" styleClass="primary-button" onAction="#onReportSighting" />
         </children>
      </HBox>
   </top>

   <!-- ============ HERO ============ -->
   <center>
      <HBox styleClass="hero" alignment="CENTER_LEFT" spacing="20">
         <padding>
            <Insets top="40" right="80" bottom="40" left="100" />
         </padding>
         <children>

            <!-- LEFT SIDE -->
            <VBox spacing="22" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" maxWidth="620">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12">
                     <children>
                        <StackPane styleClass="eyebrow-icon">
                           <children>
                              <Label text="✦" styleClass="eyebrow-icon-text" />
                           </children>
                        </StackPane>
                        <Label text="COMMUNITY-POWERED TICK AWARENESS" styleClass="eyebrow" />
                     </children>
                  </HBox>

                  <VBox spacing="-6">
                     <children>
                        <Label text="See tick activity." styleClass="headline-dark" wrapText="true" />
                        <Label text="Stay one step ahead." styleClass="headline-green" wrapText="true" prefWidth="560" />
                     </children>
                  </VBox>

                  <Label styleClass="subtitle" wrapText="true" prefWidth="560"
                         text="Explore reported tick sightings across the UK, learn what to look for, and help keep pets and people safer outdoors." />

                  <HBox alignment="CENTER_LEFT" spacing="36">
                     <padding>
                        <Insets top="10" />
                     </padding>
                     <children>
                        <Button text="Explore sightings   →" styleClass="big-button" onAction="#onExploreSightings" />
                        <Button text="Report a tick" styleClass="text-button" onAction="#onReportSighting" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="26">
                     <padding>
                        <Insets top="8" />
                     </padding>
                     <children>
                        <Label text="⛨  Public, anonymous data" styleClass="trust" />
                        <Label text="✓  Updated from the open API" styleClass="trust" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- RIGHT SIDE : image + floating cards -->
            <StackPane prefWidth="560" prefHeight="560" minWidth="560" minHeight="560">
               <children>
                  <Circle fx:id="blobCircle" radius="265" styleClass="blob" translateX="45" translateY="-35" />
                  <Circle fx:id="photoCircle" radius="250" styleClass="photo" translateX="-5" translateY="10" />

                  <Circle radius="14" styleClass="white-dot" translateX="215" translateY="-195" />
                  <Circle radius="9" styleClass="green-dot" translateX="-240" translateY="215" />

                  <!-- Card 1 -->
                  <HBox styleClass="float-card" alignment="CENTER_LEFT" spacing="14"
                        maxWidth="-Infinity" maxHeight="-Infinity" translateX="-175" translateY="-70">
                     <children>
                        <StackPane styleClass="orange-icon-box">
                           <children>
                              <Circle radius="8" styleClass="orange-dot" />
                           </children>
                        </StackPane>
                        <VBox spacing="3">
                           <children>
                              <Label text="Activity spotted" styleClass="card-title" />
                              <Label text="Manchester · 2 hours ago" styleClass="card-sub" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Card 2 -->
                  <HBox styleClass="float-card" alignment="CENTER_LEFT" spacing="14"
                        maxWidth="-Infinity" maxHeight="-Infinity" translateX="140" translateY="215">
                     <children>
                        <StackPane styleClass="green-icon-box">
                           <children>
                              <Label text="⛨" styleClass="green-icon-text" />
                           </children>
                        </StackPane>
                        <VBox spacing="3">
                           <children>
                              <Label text="Check after every walk" styleClass="card-title" />
                              <Label text="It only takes a minute" styleClass="card-sub" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </StackPane>
         </children>
      </HBox>
   </center>

   <!-- ============ BOTTOM STRIP ============ -->
   <bottom>
      <VBox styleClass="bottom-strip" prefHeight="110">
         <padding>
            <Insets top="45" right="80" bottom="30" left="140" />
         </padding>
         <children>
            <Label text="LIVE ACTIVITY EXPLORER" styleClass="strip-label" />
         </children>
      </VBox>
   </bottom>
</BorderPane>